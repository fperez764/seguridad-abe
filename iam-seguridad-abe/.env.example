# ============================================================
# iam-seguridad-abe — Variables de entorno (copiar a .env)
# ============================================================

# --- Servidor ---
PORT=3001
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# --- Base de datos (PostgreSQL, schema abeseg) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=cambia_esta_password
DB_NAME=abeseg

# --- JWT (minimo 32 caracteres; genera uno con: openssl rand -hex 32) ---
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio

# --- LDAP / Active Directory ---
LDAP_URL=ldap://dc0.tu-dominio.local:389
# Cuenta de servicio SOLO de lectura usada para buscar usuarios
LDAP_BIND_DN=cn=svc_busqueda,OU=Servicios,DC=tu-dominio,DC=local
LDAP_BIND_PASSWORD=cambia_esta_password
LDAP_SEARCH_BASE=OU=Usuarios,DC=tu-dominio,DC=local
# Plantilla de busqueda: {{username}} se reemplaza por el uid ingresado.
# Cualquier usuario registrado bajo LDAP_SEARCH_BASE puede autenticarse.
# AD: (sAMAccountName={{username}})  |  OpenLDAP: (uid={{username}})
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
# Dominio para generar correo solo si LDAP no trae atributo mail
EMAIL_FALLBACK_DOMAIN=abe.bo

# --- SMTP (envio de OTP) ---
SMTP_HOST=smtp.tu-dominio.local
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=otp@abe.bo
SMTP_PASS=cambia_esta_password
OTP_FROM=otp@abe.bo
